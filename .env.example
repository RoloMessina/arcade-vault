# Copia este archivo a .env.local y rellena los valores reales.
# Las variables de Resend son solo de servidor: no uses el prefijo NEXT_PUBLIC_.
# Las de Supabase son públicas por diseño (la seguridad la da RLS).

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# Destinatario de los mensajes de contacto.
# Con el remitente onboarding@resend.dev debe ser el correo de la cuenta de Resend.
CONTACT_TO_EMAIL=rolomessina1971@gmail.com

# Supabase: URL del proyecto y clave publicable (Project Settings > API Keys).
# Nunca pongas aquí la clave service_role.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   
